@@ -0,0 +1,68 @@
+import { beforeAll, describe, expect, it } from "bun:test";
+import { stripVTControlCharacters } from "node:util";
+import { renderSegment } from "@oh-my-pi/pi-tui/status-line/segments";
+import type { SegmentContext } from "@oh-my-pi/pi-tui/status-line/types";
+import { initTheme } from "@oh-my-pi/pi-tui/theme";
+
+beforeAll(async () => {
+	await initTheme();
+});
+
+function ctxWith(args: { cost?: number; provider?: string; oauth?: boolean; accountEmail?: string }): SegmentContext {
+	return {
+		usageStats: {
+			input: 0,
+			output: 0,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 0,
+			orchestrationInput: 0,
+			orchestrationOutput: 0,
+			orchestrationCacheRead: 0,
+			premiumRequests: 0,
+			cost: args.cost ?? 0,
+			tokensPerSecond: null,
+		},
+		accountEmail: args.accountEmail,
+		session: {
+			sessionId: "session-1",
+			state: { model: args.provider ? { provider: args.provider, id: "test-model" } : undefined },
+			modelRegistry: {
+				isUsingOAuth: () => args.oauth ?? false,
+			},
+		},
+	} as unknown as SegmentContext;
+}
+
+describe("cost status-line segment account email", () => {
+	it("appends the attributed Anthropic account email next to the cost", () => {
+		const result = renderSegment(
+			"cost",
+			ctxWith({ cost: 1.23, provider: "anthropic", oauth: true, accountEmail: "a@example.com" }),
+		);
+		expect(result.visible).toBe(true);
+		const text = stripVTControlCharacters(result.content);
+		expect(text).toContain("1.23");
+		expect(text).toContain("a@example.com");
+		expect(text.indexOf("a@example.com")).toBeGreaterThan(text.indexOf("$1.23"));
+	});
+
+	it("shows the email even at zero cost while on subscription", () => {
+		const result = renderSegment(
+			"cost",
+			ctxWith({ provider: "anthropic", oauth: true, accountEmail: "a@example.com" }),
+		);
+		expect(result.visible).toBe(true);
+		const text = stripVTControlCharacters(result.content);
+		expect(text).toContain("(sub)");
+		expect(text).toContain("a@example.com");
+	});
+
+	it("omits the email until the session is attributed", () => {
+		const result = renderSegment("cost", ctxWith({ cost: 1.23, provider: "anthropic", oauth: true }));
+		expect(result.visible).toBe(true);
+		const text = stripVTControlCharacters(result.content);
+		expect(text).toContain("1.23");
+		expect(text).not.toContain("@");
+	});
+});
