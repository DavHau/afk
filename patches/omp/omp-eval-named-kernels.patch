+/**
+ * One cell at a time per kernel, queued host-side. A cell starts its timeout
+ * only once it holds its kernel's lane, so time spent behind a running cell
+ * never counts against it, and its timeout can never interrupt that other cell
+ * (the kernel interrupt is process-wide). Calls on different kernels never
+ * contend. Keyed by backend + cwd + kernel session id.
+ */
+const kernelLanes = new Map<string, Promise<void>>();
+
+async function acquireKernelLane(key: string, signal: AbortSignal | undefined): Promise<() => void> {
+	const previous = kernelLanes.get(key) ?? Promise.resolve();
+	const { promise: held, resolve: release } = Promise.withResolvers<void>();
+	const tail = previous.then(() => held);
+	kernelLanes.set(key, tail);
+	void tail.then(() => {
+		if (kernelLanes.get(key) === tail) kernelLanes.delete(key);
+	});
+	if (signal) {
+		const aborted = Promise.withResolvers<never>();
+		const onAbort = () => aborted.reject(new ToolError("eval cancelled while waiting for its kernel"));
+		if (signal.aborted) onAbort();
+		else signal.addEventListener("abort", onAbort, { once: true });
+		try {
+			await Promise.race([previous, aborted.promise]);
+		} catch (err) {
+			// Keep the chain intact: our slot passes straight through once the
+			// cell ahead of us finishes.
+			release();
+			throw err;
+		} finally {
+			signal.removeEventListener("abort", onAbort);
+		}
+	} else {
+		await previous;
+	}
+	return release;
+}
