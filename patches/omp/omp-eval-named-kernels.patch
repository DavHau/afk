@@ -0,0 +1,78 @@
+import { afterAll, describe, expect, it } from "bun:test";
+import { TempDir } from "@oh-my-pi/pi-utils";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { disposeAllKernelSessions } from "@oh-my-pi/pi-coding-agent/eval/py/executor";
+import type { ToolSession } from "@oh-my-pi/pi-coding-agent/tools";
+import { EvalTool } from "@oh-my-pi/pi-coding-agent/tools/eval";
+
+const temp = TempDir.createSync("@omp-named-kernels-");
+
+function makeSession(): ToolSession {
+	return {
+		cwd: temp.path(),
+		hasUI: false,
+		getSessionFile: () => null,
+		getSessionSpawns: () => null,
+		settings: Settings.isolated({ "eval.autoBackground.enabled": false }),
+	} as unknown as ToolSession;
+}
+
+function text(result: { content: Array<{ type: string; text?: string }> }): string {
+	return result.content.map(block => (block.type === "text" ? (block.text ?? "") : "")).join("\n");
+}
+
+describe("EvalTool named kernels", () => {
+	afterAll(async () => {
+		await disposeAllKernelSessions();
+		temp.removeSync();
+	});
+
+	it("keeps separate state per kernel name", async () => {
+		const tool = new EvalTool(makeSession());
+		await tool.execute("seed-main", { language: "py", code: "who = 'main'", timeout: 60 });
+		await tool.execute("seed-a", { language: "py", code: "who = 'a'", kernel: "a", timeout: 60 });
+
+		expect(text(await tool.execute("read-main", { language: "py", code: "print(who)" }))).toContain("main");
+		expect(text(await tool.execute("read-a", { language: "py", code: "print(who)", kernel: "a" }))).toContain("a");
+		const fresh = await tool.execute("read-b", { language: "py", code: "print('who' in dir())", kernel: "b" });
+		expect(text(fresh)).toContain("False");
+	});
+
+	it("runs calls on different kernels in parallel", async () => {
+		const tool = new EvalTool(makeSession());
+		await tool.execute("warm-p", { language: "py", code: "import time", kernel: "p", timeout: 60 });
+		await tool.execute("warm-q", { language: "py", code: "import time", kernel: "q", timeout: 60 });
+
+		const order: string[] = [];
+		const slow = tool
+			.execute("slow-p", { language: "py", code: "time.sleep(1.5)", kernel: "p" })
+			.then(() => order.push("p"));
+		const fast = tool
+			.execute("fast-q", { language: "py", code: "print(1)", kernel: "q" })
+			.then(() => order.push("q"));
+		await Promise.all([slow, fast]);
+		expect(order).toEqual(["q", "p"]);
+	});
+
+	it("never lets a queued cell's timeout interrupt the cell running on its kernel", async () => {
+		const tool = new EvalTool(makeSession());
+		await tool.execute("warm-lane", { language: "py", code: "import time", kernel: "lane", timeout: 60 });
+
+		const first = tool.execute("first", {
+			language: "py",
+			code: "time.sleep(1.5); print('first done')",
+			kernel: "lane",
+		});
+		// Queued behind `first`; its 1 s budget must start only once it runs.
+		const second = tool.execute("second", {
+			language: "py",
+			code: "print('second done')",
+			kernel: "lane",
+			timeout: 1,
+		});
+		const [firstResult, secondResult] = await Promise.all([first, second]);
+		expect(text(firstResult)).toContain("first done");
+		expect(text(firstResult)).not.toContain("KeyboardInterrupt");
+		expect(text(secondResult)).toContain("second done");
+	});
+});
