+	fn ficlone_supported_in(dir: &Path) -> bool {
+		// Non-empty source: cloning a zero-length file is degenerate and can
+		// fail (EINVAL) even on filesystems whose extent cloning works.
+		fs::write(dir.join("probe-src"), b"probe").unwrap();
+		let src = fs::File::open(dir.join("probe-src")).unwrap();
+		let dst = fs::File::create(dir.join("probe-dst")).unwrap();
+		// SAFETY: both fds are valid for the duration of the call.
+		let rc = unsafe { libc::ioctl(dst.as_raw_fd(), FICLONE, src.as_raw_fd()) };
+		let _ = fs::remove_file(dir.join("probe-src"));
+		let _ = fs::remove_file(dir.join("probe-dst"));
+		rc == 0
+	}
