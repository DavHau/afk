+		fs::create_dir(lower.join("sub")).unwrap();
+		fs::write(lower.join("sub/nested.bin"), vec![0xa5u8; 8192]).unwrap();
+		std::os::unix::fs::symlink("file.txt", lower.join("link")).unwrap();
