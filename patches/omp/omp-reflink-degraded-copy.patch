+		fs::write(lower.join("file.txt"), b"parent wrote after dispatch").unwrap();
+		fs::write(lower.join("new-parent-file"), b"late").unwrap();
+		assert_eq!(fs::read(merged.join("file.txt")).unwrap(), b"reflink me");
+		assert!(!merged.join("new-parent-file").exists());
