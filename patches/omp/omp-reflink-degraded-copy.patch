+		let lower = build_lower(&dir);
+		let merged = dir.join("merged");
+
+		imp::start(&lower, &merged, false).unwrap();
+
+		assert_eq!(fs::read(merged.join("file.txt")).unwrap(), b"reflink me");
+		assert_eq!(fs::read(merged.join("sub/nested.bin")).unwrap(), vec![0xa5u8; 8192]);
+		assert_eq!(
+			fs::read_link(merged.join("link")).unwrap(),
+			PathBuf::from("file.txt")
