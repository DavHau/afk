+		// Permissive mode: the tree materialises via byte copies.
+		imp::start(&lower, &merged, false).unwrap();
+		assert_eq!(fs::read(merged.join("file.txt")).unwrap(), b"reflink me");
+		assert_eq!(fs::read(merged.join("sub/nested.bin")).unwrap(), vec![0xa5u8; 8192]);
+		imp::stop(&merged).unwrap();
+
+		// Strict mode: the same tree must refuse to materialise.
+		let err = imp::start(&lower, &merged, true).unwrap_err();
+		assert!(err.is_unavailable(), "expected Unavailable, got: {err}");
+		assert!(!merged.exists());
