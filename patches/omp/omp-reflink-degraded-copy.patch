+		if !shm.is_dir() {
+			return;
+		}
+		let dir = shm.join(format!("pi-iso-reflink-fallback-{}", std::process::id()));
+		let _ = fs::remove_dir_all(&dir);
+		fs::create_dir_all(&dir).unwrap();
+		let lower = build_lower(&dir);
+		let merged = dir.join("merged");
+
+		if ficlone_supported_in(&dir) {
+			let _ = fs::remove_dir_all(&dir);
+			return;
+		}
