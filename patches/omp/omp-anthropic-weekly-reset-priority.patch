+++ b/packages/ai/test/auth-storage-claude-weekly-reset-priority.test.ts
@@ -0,0 +1,209 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import {
+	type AuthCredential,
+	type AuthCredentialStore,
+	AuthStorage,
+	SqliteAuthCredentialStore,
+} from "@oh-my-pi/pi-ai/auth-storage";
+import type { UsageReport } from "@oh-my-pi/pi-ai/usage";
+import * as claudeUsage from "@oh-my-pi/pi-ai/usage/claude";
+import { removeWithRetries } from "../../utils/src/temp";
+
+function oauthCredential(id: number, email: string): AuthCredential {
+	return {
+		type: "oauth",
+		access: `oat-${id}`,
+		refresh: `refresh-${id}`,
+		expires: Date.now() + 3_600_000,
+		accountId: `account-${id}`,
+		email,
+	};
+}
+
+function report(
+	email: string,
+	args: { weeklyUsed: number; weeklyResetsAt?: number; sessionUsed?: number },
+): UsageReport {
+	const sessionUsed = args.sessionUsed ?? 0.1;
+	return {
+		provider: "anthropic",
+		fetchedAt: Date.now(),
+		limits: [
+			{
+				id: "anthropic:5h",
+				label: "Claude 5 Hour",
+				scope: { provider: "anthropic", windowId: "5h", shared: true },
+				window: { id: "5h", label: "5 Hour" },
+				amount: { used: sessionUsed * 100, limit: 100, usedFraction: sessionUsed, unit: "percent" },
+				status: sessionUsed >= 1 ? "exhausted" : "ok",
+			},
+			{
+				id: "anthropic:7d",
+				label: "Claude 7 Day",
+				scope: { provider: "anthropic", windowId: "7d", shared: true },
+				window: {
+					id: "7d",
+					label: "7 Day",
+					durationMs: 7 * 24 * 60 * 60 * 1000,
+					...(args.weeklyResetsAt === undefined ? {} : { resetsAt: args.weeklyResetsAt }),
+				},
+				amount: { used: args.weeklyUsed * 100, limit: 100, usedFraction: args.weeklyUsed, unit: "percent" },
+				status: args.weeklyUsed >= 1 ? "exhausted" : "ok",
+			},
+		],
+		metadata: { email, accountId: email },
+	};
+}
+
+function mockUsage(reportsByAccess: Record<string, UsageReport>): void {
+	vi.spyOn(claudeUsage.claudeUsageProvider, "fetchUsage").mockImplementation(async params => {
+		const access = params.credential.type === "oauth" ? params.credential.accessToken : undefined;
+		if (!access) return null;
+		return reportsByAccess[access] ?? null;
+	});
+}
+
+describe("AuthStorage Claude weekly reset priority", () => {
+	let tempDir = "";
+	let store: AuthCredentialStore;
+	let storage: AuthStorage;
+
+	beforeEach(async () => {
+		tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "pi-ai-claude-weekly-reset-"));
+		store = await SqliteAuthCredentialStore.open(path.join(tempDir, "agent.db"));
+		storage = new AuthStorage(store, {
+			usageProviderResolver: provider => (provider === "anthropic" ? claudeUsage.claudeUsageProvider : undefined),
+		});
+		await storage.credentials.set("anthropic", [
+			oauthCredential(1, "a@example.com"),
+			oauthCredential(2, "b@example.com"),
+		]);
+	});
+
+	afterEach(async () => {
+		vi.restoreAllMocks();
+		storage.close();
+		await removeWithRetries(tempDir);
+	});
+
+	function credentialIdOf(email: string): number {
+		const account = storage.oauth.accounts("anthropic").find(entry => entry.email === email);
+		if (!account) throw new Error(`expected stored account ${email}`);
+		return account.credentialId;
+	}
+
+	it("always prefers the account whose weekly window resets sooner, for every session", async () => {
+		const now = Date.now();
+		mockUsage({
+			// Account 1: weekly resets tomorrow, heavily used (high drain rate).
+			"oat-1": report("a@example.com", { weeklyUsed: 0.8, weeklyResetsAt: now + 24 * 60 * 60 * 1000 }),
+			// Account 2: weekly resets in six days, barely used (low drain rate).
+			"oat-2": report("b@example.com", { weeklyUsed: 0.1, weeklyResetsAt: now + 6 * 24 * 60 * 60 * 1000 }),
+		});
+
+		for (let n = 0; n < 16; n += 1) {
+			const key = await storage.keys.get("anthropic", `session-reset-${n}`);
+			expect(key).toBe("oat-1");
+		}
+	});
+
+	it("skips an exhausted sooner-reset account instead of pinning to it", async () => {
+		const now = Date.now();
+		mockUsage({
+			// Sooner weekly reset, but the shared session window is exhausted.
+			"oat-1": report("a@example.com", {
+				weeklyUsed: 0.9,
+				weeklyResetsAt: now + 24 * 60 * 60 * 1000,
+				sessionUsed: 1.0,
+			}),
+			"oat-2": report("b@example.com", { weeklyUsed: 0.1, weeklyResetsAt: now + 6 * 24 * 60 * 60 * 1000 }),
+		});
+
+		const key = await storage.keys.get("anthropic", "session-exhausted");
+
+		expect(key).toBe("oat-2");
+	});
+
+	it("ranks an account with an unknown weekly reset after one with a known reset", async () => {
+		const now = Date.now();
+		mockUsage({
+			// No resetsAt reported at all, otherwise idle.
+			"oat-1": report("a@example.com", { weeklyUsed: 0.0 }),
+			// Known reset far out, busier.
+			"oat-2": report("b@example.com", { weeklyUsed: 0.5, weeklyResetsAt: now + 6 * 24 * 60 * 60 * 1000 }),
+		});
+
+		for (let n = 0; n < 16; n += 1) {
+			const key = await storage.keys.get("anthropic", `session-unknown-${n}`);
+			expect(key).toBe("oat-2");
+		}
+	});
+
+	it("resolves tied weekly resets to one deterministic pick", async () => {
+		const now = Date.now();
+		const resetsAt = now + 3 * 24 * 60 * 60 * 1000;
+		mockUsage({
+			"oat-1": report("a@example.com", { weeklyUsed: 0.3, weeklyResetsAt: resetsAt }),
+			"oat-2": report("b@example.com", { weeklyUsed: 0.3, weeklyResetsAt: resetsAt }),
+		});
+
+		// Ranking is deterministic: resets within the tie tolerance
+		// (and every downstream metric) leave the candidates equal, so the
+		// first stored credential wins every session rather than load
+		// balancing.
+		const picked = new Set<string>();
+		for (let n = 0; n < 32; n += 1) {
+			const key = await storage.keys.get("anthropic", `session-tie-${n}`);
+			if (key) picked.add(key);
+		}
+
+		expect(picked.size).toBe(1);
+	});
+
+	describe("warm session pin", () => {
+		const DAY_MS = 24 * 60 * 60 * 1000;
+
+		it("moves a warm automatic pin once a sibling's weekly window resets sooner", async () => {
+			const now = Date.now();
+			mockUsage({
+				"oat-1": report("a@example.com", { weeklyUsed: 0.02, weeklyResetsAt: now + 3 * DAY_MS }),
+				"oat-2": report("b@example.com", { weeklyUsed: 0.09, weeklyResetsAt: now + 6 * DAY_MS }),
+			});
+			// A session-restored attribution used moments ago: warm, not a manual choice.
+			expect(
+				storage.sessions.pin("anthropic", "session-warm", credentialIdOf("b@example.com"), { restoredAtMs: now }),
+			).toBe(true);
+
+			expect(await storage.keys.get("anthropic", "session-warm")).toBe("oat-1");
+		});
+
+		it("keeps a warm automatic pin when only usage, not the reset order, favours a sibling", async () => {
+			const now = Date.now();
+			const resetsAt = now + 3 * DAY_MS;
+			mockUsage({
+				"oat-1": report("a@example.com", { weeklyUsed: 0.1, weeklyResetsAt: resetsAt }),
+				"oat-2": report("b@example.com", { weeklyUsed: 0.5, weeklyResetsAt: resetsAt + 30_000 }),
+			});
+			expect(
+				storage.sessions.pin("anthropic", "session-tied", credentialIdOf("b@example.com"), { restoredAtMs: now }),
+			).toBe(true);
+
+			expect(await storage.keys.get("anthropic", "session-tied")).toBe("oat-2");
+		});
+
+		it("keeps a manual pin even when a sibling's weekly window resets sooner", async () => {
+			const now = Date.now();
+			mockUsage({
+				"oat-1": report("a@example.com", { weeklyUsed: 0.02, weeklyResetsAt: now + 3 * DAY_MS }),
+				"oat-2": report("b@example.com", { weeklyUsed: 0.09, weeklyResetsAt: now + 6 * DAY_MS }),
+			});
+			expect(storage.sessions.pin("anthropic", "session-manual", credentialIdOf("b@example.com"))).toBe(true);
+
+			expect(await storage.keys.get("anthropic", "session-manual")).toBe("oat-2");
+			expect(await storage.keys.get("anthropic", "session-manual")).toBe("oat-2");
+		});
+	});
+});
