diff --git a/packages/ai/test/auth-storage-pin-credential.test.ts b/packages/ai/test/auth-storage-pin-credential.test.ts
new file mode 100644
index 0000000000..ae4cf15529
--- /dev/null
+++ b/packages/ai/test/auth-storage-pin-credential.test.ts
@@ -0,0 +1,132 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { type AuthCredentialStore, AuthStorage, SqliteAuthCredentialStore } from "@oh-my-pi/pi-ai/auth-storage";
+import * as oauthUtils from "@oh-my-pi/pi-ai/registry/oauth";
+import { removeWithRetries } from "../../utils/src/temp";
+
+const PROVIDER = "unit-oauth-pin";
+
+describe("AuthStorage.sessions.pin block clearing", () => {
+	let tempDir = "";
+	let store: AuthCredentialStore | null = null;
+	let authStorage: AuthStorage | null = null;
+
+	beforeEach(async () => {
+		tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "pi-ai-auth-pin-"));
+		store = await SqliteAuthCredentialStore.open(path.join(tempDir, "agent.db"));
+		authStorage = new AuthStorage(store);
+	});
+
+	afterEach(async () => {
+		vi.restoreAllMocks();
+		store?.close();
+		store = null;
+		authStorage = null;
+		if (tempDir) {
+			await removeWithRetries(tempDir);
+			tempDir = "";
+		}
+	});
+
+	async function seedTwoAccounts(storage: AuthStorage): Promise<void> {
+		await storage.credentials.set(PROVIDER, [
+			{
+				type: "oauth",
+				access: "access-a",
+				refresh: "refresh-a",
+				expires: Date.now() + 60 * 60_000,
+				accountId: "acc-a",
+				email: "a@example.com",
+			},
+			{
+				type: "oauth",
+				access: "access-b",
+				refresh: "refresh-b",
+				expires: Date.now() + 60 * 60_000,
+				accountId: "acc-b",
+				email: "b@example.com",
+			},
+		]);
+		vi.spyOn(oauthUtils, "getOAuthApiKey").mockImplementation(async (provider, credentials) => {
+			const credential = credentials[provider];
+			if (!credential) return null;
+			return { newCredentials: credential, apiKey: credential.access };
+		});
+	}
+
+	interface BlockedSetup {
+		blockedId: number;
+		blockedAccess: string;
+		otherAccess: string;
+	}
+
+	/** Route a throwaway session to whichever account wins, then rate-limit-block it. */
+	async function blockFirstPick(storage: AuthStorage): Promise<BlockedSetup> {
+		const blockSession = "session-pin-block-setup";
+		const blockedKey = await storage.keys.get(PROVIDER, blockSession);
+		if (blockedKey !== "access-a" && blockedKey !== "access-b") throw new Error("expected a stored access token");
+		await storage.limits.markReached(PROVIDER, blockSession, { retryAfterMs: 60 * 60_000 });
+		const blockedEmail = blockedKey === "access-a" ? "a@example.com" : "b@example.com";
+		const blocked = storage.oauth.accounts(PROVIDER).find(account => account.email === blockedEmail);
+		if (!blocked) throw new Error("expected the blocked account to be stored");
+		return {
+			blockedId: blocked.credentialId,
+			blockedAccess: blockedKey,
+			otherAccess: blockedKey === "access-a" ? "access-b" : "access-a",
+		};
+	}
+
+	test("pins the session to the chosen account and getApiKey honors it", async () => {
+		if (!authStorage) throw new Error("test setup failed");
+		const storage = authStorage;
+		const sessionId = "session-pin-fresh";
+		await seedTwoAccounts(storage);
+
+		const target = storage.oauth.accounts(PROVIDER).find(account => account.email === "b@example.com");
+		if (!target) throw new Error("expected stored account b");
+
+		expect(storage.sessions.pin(PROVIDER, sessionId, target.credentialId)).toBe(true);
+		expect(storage.oauth.identity(PROVIDER, sessionId, { sessionStickyOnly: true })?.email).toBe("b@example.com");
+
+		expect(await storage.keys.get(PROVIDER, sessionId)).toBe("access-b");
+	});
+
+	test("rejects credential ids that do not name a stored OAuth credential", async () => {
+		if (!authStorage) throw new Error("test setup failed");
+		const storage = authStorage;
+		const sessionId = "session-pin-invalid";
+		await seedTwoAccounts(storage);
+
+		expect(storage.sessions.pin(PROVIDER, sessionId, 999_999)).toBe(false);
+		expect(storage.oauth.identity(PROVIDER, sessionId, { sessionStickyOnly: true })).toBeUndefined();
+	});
+
+	test("a manual pin clears rate-limit blocks so the next request tries the account", async () => {
+		if (!authStorage) throw new Error("test setup failed");
+		const storage = authStorage;
+		await seedTwoAccounts(storage);
+		const setup = await blockFirstPick(storage);
+
+		// Blocked: a fresh session rotates away from the blocked account.
+		expect(await storage.keys.get(PROVIDER, "session-pin-rotated")).toBe(setup.otherAccess);
+
+		const sessionId = "session-pin-unblock";
+		expect(storage.sessions.pin(PROVIDER, sessionId, setup.blockedId)).toBe(true);
+		// The manual pin cleared the block, so the pinned account serves.
+		expect(await storage.keys.get(PROVIDER, sessionId)).toBe(setup.blockedAccess);
+	});
+
+	test("a persisted-session restore keeps rate-limit blocks in place", async () => {
+		if (!authStorage) throw new Error("test setup failed");
+		const storage = authStorage;
+		await seedTwoAccounts(storage);
+		const setup = await blockFirstPick(storage);
+
+		const sessionId = "session-pin-restore";
+		expect(storage.sessions.pin(PROVIDER, sessionId, setup.blockedId, { restoredAtMs: Date.now() })).toBe(true);
+		// Restore must not lift the block: selection routes around the account.
+		expect(await storage.keys.get(PROVIDER, sessionId)).toBe(setup.otherAccess);
+	});
+});
