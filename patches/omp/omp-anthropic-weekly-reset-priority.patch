+	});
+
+	afterEach(async () => {
+		vi.restoreAllMocks();
+		store?.close();
+		store = null;
+		authStorage = null;
+		if (tempDir) {
+			await removeWithRetries(tempDir);
+			tempDir = "";
+		}
+	});
+
+	async function seedTwoAccounts(storage: AuthStorage): Promise<void> {
+		await storage.set(PROVIDER, [
+			{
+				type: "oauth",
+				access: "access-a",
+				refresh: "refresh-a",
+				expires: Date.now() + 60 * 60_000,
+				accountId: "acc-a",
+				email: "a@example.com",
+			},
+			{
+				type: "oauth",
+				access: "access-b",
+				refresh: "refresh-b",
+				expires: Date.now() + 60 * 60_000,
+				accountId: "acc-b",
+				email: "b@example.com",
+			},
+		]);
+		vi.spyOn(oauthUtils, "getOAuthApiKey").mockImplementation(async (provider, credentials) => {
+			const credential = credentials[provider];
+			if (!credential) return null;
+			return { newCredentials: credential, apiKey: credential.access };
+		});
+	}
+
+	test("pins the session to the chosen account and getApiKey honors it", async () => {
+		if (!authStorage) throw new Error("test setup failed");
+		const storage = authStorage;
+		const sessionId = "session-pin-fresh";
+		await seedTwoAccounts(storage);
+
+		const target = storage.listOAuthAccounts(PROVIDER).find(account => account.email === "b@example.com");
+		if (!target) throw new Error("expected stored account b");
+
+		const pinned = storage.pinSessionCredential(PROVIDER, sessionId, target.credentialId);
+		expect(pinned?.email).toBe("b@example.com");
+		expect(storage.getOAuthAccountIdentity(PROVIDER, sessionId, { sessionStickyOnly: true })?.email).toBe(
+			"b@example.com",
+		);
+
+		expect(await storage.getApiKey(PROVIDER, sessionId)).toBe("access-b");
+	});
+
+	test("rejects credential ids that do not name a stored OAuth credential", async () => {
+		if (!authStorage) throw new Error("test setup failed");
+		const storage = authStorage;
+		const sessionId = "session-pin-invalid";
+		await seedTwoAccounts(storage);
+
+		expect(storage.pinSessionCredential(PROVIDER, sessionId, 999_999)).toBeUndefined();
+		expect(storage.getOAuthAccountIdentity(PROVIDER, sessionId, { sessionStickyOnly: true })).toBeUndefined();
+	});
+
+	test("overrides a previously attributed account", async () => {
+		if (!authStorage) throw new Error("test setup failed");
+		const storage = authStorage;
+		const sessionId = "session-pin-switch";
+		await seedTwoAccounts(storage);
+
+		const firstKey = await storage.getApiKey(PROVIDER, sessionId);
+		const other = storage
+			.listOAuthAccounts(PROVIDER)
+			.find(account => account.email !== storage.getOAuthAccountIdentity(PROVIDER, sessionId)?.email);
+		if (!other) throw new Error("expected a sibling account");
+
+		const pinned = storage.pinSessionCredential(PROVIDER, sessionId, other.credentialId);
+		expect(pinned?.email).toBe(other.email);
+
+		const nextKey = await storage.getApiKey(PROVIDER, sessionId);
+		expect(nextKey).not.toBe(firstKey);
+		expect(nextKey).toBe(other.email === "a@example.com" ? "access-a" : "access-b");
+	});
