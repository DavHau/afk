new file mode 100644
index 0000000000..40bf9d7669
--- /dev/null
+++ b/packages/coding-agent/src/task/vcs.ts
@@ -0,0 +1,188 @@
+/**
+ * VCS seam for isolated task execution.
+ *
+ * Task isolation has two VCS-shaped phases wrapped around a VCS-agnostic
+ * filesystem snapshot (the PAL backend):
+ *
+ *   1. capture — record a baseline from the fresh isolation copy, then
+ *      diff/commit the isolated worktree against it after the agent finishes,
+ *   2. merge-back — land those captured changes in the (live, possibly
+ *      moved-on) parent workspace, surfacing overlaps as conflicts.
+ *
+ * Both phases go through this `VcsHandle` interface instead of calling the
+ * native git layer directly, so alternative backends (e.g. jj workspaces
+ * resolving their shared backing git store) can plug in without touching the
+ * isolation lifecycle in `isolation-runner.ts` or its callers.
+ *
+ * `GitCheckoutHandle` is the only implementation today and delegates to the
+ * existing machinery in `worktree.ts` / `@oh-my-pi/pi-natives/vcs` unchanged.
+ */
+import * as vcs from "@oh-my-pi/pi-natives/vcs";
+import type { NestedRepoPatch } from "@oh-my-pi/pi-tui/tools/task";
+import {
+	applyNestedPatches,
+	captureDeltaPatch,
+	captureIsolationBaseline,
+	cleanupTaskBranches,
+	type CommitToBranchResult,
+	commitToBranch,
+	type DeltaPatchResult,
+	getRepoRoot,
+	type MergeBranchResult,
+	mergeTaskBranches,
+	taskBranchRef,
+	type WorktreeBaseline,
+} from "./worktree";
+
+/** A task ref to merge back into the parent workspace (branch mode). */
+export interface TaskRefMergeSpec {
+	branchName: string;
+	taskId: string;
+	description?: string;
+	baseSha?: string;
+}
+
+/**
+ * VCS operations required by isolated task execution. One handle is resolved
+ * per isolation context (i.e. per task-tool call / eval `agent()` spawn batch)
+ * and shared by every spawn in that call.
+ */
+export interface VcsHandle {
+	/** Backend discriminator; drives capability checks and user messaging. */
+	readonly kind: "git";
+	/** Workspace root — the directory the PAL snapshots and merges land in. */
+	readonly root: string;
+
+	/**
+	 * Record the baseline of a freshly materialised isolation copy, rebound to
+	 * the parent workspace — the copy's own state is the only exact baseline
+	 * (the live parent may have drifted since the snapshot).
+	 */
+	captureIsolationBaseline(isolationDir: string): Promise<WorktreeBaseline>;
+	/** Diff the isolated worktree against the baseline (patch mode + recovery artifacts). */
+	captureDelta(isolationDir: string, baseline: WorktreeBaseline): Promise<DeltaPatchResult>;
+	/**
+	 * Commit task-only changes from the isolated worktree onto a parked task
+	 * ref (branch mode). Returns `null` when there is nothing to commit.
+	 */
+	commitToTaskRef(
+		isolationDir: string,
+		baseline: WorktreeBaseline,
+		taskId: string,
+		description: string | undefined,
+		commitMessage?: (diff: string) => Promise<string | null>,
+	): Promise<CommitToBranchResult | null>;
+	/**
+	 * Throw when the parent workspace is no longer a valid checkout. The merge
+	 * phase calls this before anything else so a vanished workspace fails the
+	 * merge outright instead of degrading into a merge-error summary.
+	 */
+	assertMergeTarget(): void;
+	/** Land parked task refs in the parent workspace; overlaps surface as conflicts. */
+	mergeTaskRefs(refs: TaskRefMergeSpec[]): Promise<MergeBranchResult>;
+	/** Delete parked task refs after a successful merge. */
+	cleanupTaskRefs(branchNames: string[]): Promise<void>;
+	/**
+	 * Decide the fate of a half-built task ref after apply-back threw: keep it
+	 * (returning its name) when it carries commits past `baseSha` — the
+	 * isolation snapshot that also held those objects is about to be torn
+	 * down — and delete it otherwise. See #8868.
+	 */
+	rescueTaskRef(branchName: string, baseSha: string): Promise<string | undefined>;
+
+	/** Check whether a delta patch applies cleanly to the parent workspace (read-only). */
+	canApplyPatch(patchText: string, options?: { reverse?: boolean }): Promise<boolean>;
+	/** Apply a delta patch to the parent workspace (patch mode merge). */
+	applyPatch(patchText: string): Promise<void>;
+	/** Apply nested-repo patches to their working directories; returns warnings. */
+	applyNestedPatches(
+		patches: NestedRepoPatch[],
+		commitMessage?: (diff: string) => Promise<string | null>,
+	): Promise<string[]>;
+}
+
+/** Plain git checkout — delegates to the existing worktree/native machinery. */
+export class GitCheckoutHandle implements VcsHandle {
+	readonly kind = "git" as const;
+	constructor(readonly root: string) {}
+
+	captureIsolationBaseline(isolationDir: string): Promise<WorktreeBaseline> {
+		return captureIsolationBaseline(isolationDir, this.root);
+	}
+
+	captureDelta(isolationDir: string, baseline: WorktreeBaseline): Promise<DeltaPatchResult> {
+		return captureDeltaPatch(isolationDir, baseline);
+	}
+
+	commitToTaskRef(
+		isolationDir: string,
+		baseline: WorktreeBaseline,
+		taskId: string,
+		description: string | undefined,
+		commitMessage?: (diff: string) => Promise<string | null>,
+	): Promise<CommitToBranchResult | null> {
+		return commitToBranch(isolationDir, baseline, taskId, description, commitMessage);
+	}
+
+	assertMergeTarget(): void {
+		vcs.requireGit(this.root);
+	}
+
+	mergeTaskRefs(refs: TaskRefMergeSpec[]): Promise<MergeBranchResult> {
+		return mergeTaskBranches(this.root, refs);
+	}
+
+	cleanupTaskRefs(branchNames: string[]): Promise<void> {
+		return cleanupTaskBranches(this.root, branchNames);
+	}
+
+	async rescueTaskRef(branchName: string, baseSha: string): Promise<string | undefined> {
+		const repo = vcs.git(this.root);
+		// Task refs live at `refs/omp/task/<id>`, outside `refs/heads/`, so a
+		// colocated jj checkout never imports (and later abandons) them.
+		const tipRef = taskBranchRef(branchName);
+		try {
+			const carriedCommits = (await vcs.requireGit(this.root).revListRange(baseSha, tipRef)).length;
+			if (carriedCommits > 0) return branchName;
+		} catch {
+			try {
+				if (await repo?.refExists(tipRef)) return branchName;
+			} catch {
+				// An inconclusive recovery probe must never risk deleting the only ref.
+				return branchName;
+			}
+		}
+		await this.cleanupTaskRefs([branchName]);
+		return undefined;
+	}
+
+	canApplyPatch(patchText: string, options?: { reverse?: boolean }): Promise<boolean> {
+		return vcs
+			.requireGit(this.root)
+			.canApplyPatch(patchText, options?.reverse ? { reverse: true } : {})
+			.catch(() => false);
+	}
+
+	async applyPatch(patchText: string): Promise<void> {
+		await vcs.requireGit(this.root).applyPatch(patchText, {});
+	}
+
+	applyNestedPatches(
+		patches: NestedRepoPatch[],
+		commitMessage?: (diff: string) => Promise<string | null>,
+	): Promise<string[]> {
+		return applyNestedPatches(this.root, patches, commitMessage);
+	}
+}
+
+/**
+ * Resolve the VCS handle for isolated task execution at `cwd`.
+ *
+ * Today: nearest git checkout wins; a pure jj workspace (`.jj/` without a
+ * colocated `.git/`) is rejected with colocation guidance — the same gate
+ * `getRepoRoot` has always enforced. A future jj handle slots in here.
+ */
+export async function resolveVcsHandle(cwd: string): Promise<VcsHandle> {
+	const root = await getRepoRoot(cwd);
+	return new GitCheckoutHandle(root);
+}
