index 0000000..bf8971e
--- /dev/null
+++ b/packages/coding-agent/test/modes/controllers/event-controller-openai-args.test.ts
@@ -0,0 +1,101 @@
+/**
+ * Repro: openai-completions-style streaming — the provider throttle-parses
+ * `block.arguments` (every ~256 bytes) but never sets kStreamingPartialJson.
+ * Contract under test: the pending write preview must still grow while args
+ * stream (path + partial content visible), matching the partialJson path.
+ */
+import { afterEach, beforeAll, describe, expect, it, vi } from "bun:test";
+import type { AssistantMessage } from "@oh-my-pi/pi-ai";
+import { resetSettingsForTest, Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { ToolExecutionComponent } from "@oh-my-pi/pi-coding-agent/modes/components/tool-execution";
+import { EventController } from "@oh-my-pi/pi-coding-agent/modes/controllers/event-controller";
+import { initTheme } from "@oh-my-pi/pi-coding-agent/modes/theme/theme";
+import type { InteractiveModeContext } from "@oh-my-pi/pi-coding-agent/modes/types";
+import type { AgentSessionEvent } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+
+beforeAll(async () => {
+	await initTheme();
+});
+
+function makeStreamingMessage(content: AssistantMessage["content"]): AssistantMessage {
+	return {
+		role: "assistant",
+		content,
+		api: "openai-completions",
+		provider: "bam-vm",
+		model: "m",
+		usage: {
+			input: 0,
+			output: 0,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 0,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: "stop",
+		timestamp: 0,
+	} as unknown as AssistantMessage;
+}
+
+function createFixture(streamingMessage: AssistantMessage) {
+	const pendingTools = new Map<string, ToolExecutionComponent>();
+	const ctx = {
+		isInitialized: true,
+		streamingMessage,
+		streamingComponent: { setHideThinkingBlock() {}, markTranscriptBlockFinalized() {} },
+		noteDisplayableThinkingContent: () => false,
+		effectiveHideThinkingBlock: false,
+		pendingTools,
+		chatContainer: { addChild() {} },
+		ui: {
+			requestRender() {},
+			requestComponentRender() {},
+		},
+		viewSession: { getToolByName: () => undefined, hasBuiltInTool: () => true },
+		sessionManager: { getCwd: () => process.cwd() },
+		settings: { get: () => true },
+		toolOutputExpanded: false,
+	} as unknown as InteractiveModeContext;
+	return { controller: new EventController(ctx), pendingTools };
+}
+
+async function dispatch(controller: EventController, message: AssistantMessage) {
+	await controller.handleEvent({
+		type: "message_update",
+		message,
+		assistantMessageEvent: { type: "toolcall_delta", contentIndex: 0, delta: "", partial: message },
+	} as Extract<AgentSessionEvent, { type: "message_update" }>);
+}
+
+describe("openai-completions style streaming (parsed arguments, no partialJson symbol)", () => {
+	afterEach(() => {
+		vi.useRealTimers();
+		resetSettingsForTest();
+		vi.restoreAllMocks();
+	});
+
+	it("renders a growing write preview from throttle-parsed arguments", async () => {
+		await Settings.init({ inMemory: true, cwd: process.cwd() });
+		const body = 'print("line 1")\n'.repeat(40);
+		// Parse #1: path plus first slice of content (what parseStreamingJsonThrottled yields)
+		const first = makeStreamingMessage([
+			{ type: "toolCall", id: "tc-1", name: "write", arguments: { path: "/tmp/demo.py", content: body.slice(0, 64) } },
+		]);
+		const { controller, pendingTools } = createFixture(first);
+		await dispatch(controller, first);
+		expect(pendingTools.size).toBe(1);
+		const component = pendingTools.get("tc-1")!;
+		const frame1 = Bun.stripANSI(component.render(100).join("\n"));
+		expect(frame1).toContain("demo.py");
+		expect(frame1).toContain('print("line 1")');
+
+		// Parse #2: content grew by another throttle window
+		const second = makeStreamingMessage([
+			{ type: "toolCall", id: "tc-1", name: "write", arguments: { path: "/tmp/demo.py", content: body.slice(0, 320) } },
+		]);
+		await dispatch(controller, second);
+		const frame2 = Bun.stripANSI(component.render(100).join("\n"));
+		expect(frame2).toContain('print("line 1")');
+		expect(frame2.length).toBeGreaterThanOrEqual(frame1.length);
+	});
+});
diff --git a/packages/coding-agent/test/modes/controllers/event-controller-partial-name.test.ts b/packages/coding-agent/test/modes/controllers/event-controller-partial-name.test.ts
new file mode 100644
index 0000000..e256864
--- /dev/null
+++ b/packages/coding-agent/test/modes/controllers/event-controller-partial-name.test.ts
@@ -0,0 +1,121 @@
+/**
+ * Contract: providers may stream a tool call whose NAME is still a partial
+ * prefix when the call first surfaces, growing in later updates while the
+ * call id stays stable (llama.cpp's chat-diff streaming does exactly this:
+ * `common_chat_msg_diff::compute_diffs` explicitly tolerates prefix->longer
+ * name transitions, and the server generates the id at first surfacing).
+ *
+ * The pending tool component must rebind to the settled name — otherwise it
+ * stays on the generic renderer ("wri" has no renderer) and write/edit
+ * previews render blank until the tool completes.
+ */
+import { afterEach, beforeAll, describe, expect, it, vi } from "bun:test";
+import type { AssistantMessage } from "@oh-my-pi/pi-ai";
+import { resetSettingsForTest, Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { ToolExecutionComponent } from "@oh-my-pi/pi-coding-agent/modes/components/tool-execution";
+import { EventController } from "@oh-my-pi/pi-coding-agent/modes/controllers/event-controller";
+import { initTheme } from "@oh-my-pi/pi-coding-agent/modes/theme/theme";
+import type { InteractiveModeContext } from "@oh-my-pi/pi-coding-agent/modes/types";
+import type { AgentSessionEvent } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+
+beforeAll(async () => {
+	await initTheme();
+});
+
+function makeStreamingMessage(content: AssistantMessage["content"]): AssistantMessage {
+	return {
+		role: "assistant",
+		content,
+		api: "openai-completions",
+		provider: "mock",
+		model: "m",
+		usage: {
+			input: 0,
+			output: 0,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 0,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: "stop",
+		timestamp: 0,
+	} as unknown as AssistantMessage;
+}
+
+function createFixture() {
+	const pendingTools = new Map<string, ToolExecutionComponent>();
+	const removed: unknown[] = [];
+	const ctx = {
+		isInitialized: true,
+		streamingMessage: undefined as AssistantMessage | undefined,
+		streamingComponent: { setHideThinkingBlock() {}, markTranscriptBlockFinalized() {} },
+		noteDisplayableThinkingContent: () => false,
+		effectiveHideThinkingBlock: false,
+		pendingTools,
+		chatContainer: {
+			addChild() {},
+			removeChild(component: unknown) {
+				removed.push(component);
+			},
+			canRemoveBlock: () => true,
+		},
+		ui: {
+			requestRender() {},
+			requestComponentRender() {},
+		},
+		viewSession: { getToolByName: () => undefined, hasBuiltInTool: () => true },
+		sessionManager: { getCwd: () => process.cwd() },
+		settings: { get: () => true },
+		toolOutputExpanded: false,
+	} as unknown as InteractiveModeContext;
+	return { controller: new EventController(ctx), pendingTools, ctx, removed };
+}
+
+async function dispatch(controller: EventController, ctx: InteractiveModeContext, message: AssistantMessage) {
+	(ctx as unknown as { streamingMessage: AssistantMessage }).streamingMessage = message;
+	await controller.handleEvent({
+		type: "message_update",
+		message,
+		assistantMessageEvent: { type: "toolcall_delta", contentIndex: 0, delta: "", partial: message },
+	} as Extract<AgentSessionEvent, { type: "message_update" }>);
+}
+
+describe("streamed tool call with incrementally-growing name (llama.cpp shape)", () => {
+	afterEach(() => {
+		vi.useRealTimers();
+		resetSettingsForTest();
+		vi.restoreAllMocks();
+	});
+
+	it("rebinds the pending component to the settled name so the write preview streams", async () => {
+		await Settings.init({ inMemory: true, cwd: process.cwd() });
+		const { controller, pendingTools, ctx } = createFixture();
+		const body = 'print("line 1")\nprint("line 2")\nprint("line 3")\n';
+
+		// First surfacing: stable id, partial name, no parsed args yet.
+		await dispatch(
+			controller,
+			ctx,
+			makeStreamingMessage([{ type: "toolCall", id: "tc-1", name: "wri", arguments: {} }]),
+		);
+		expect(pendingTools.size).toBe(1);
+
+		// Name settles; args stream in (openai-completions shape: parsed
+		// `arguments`, no partial-JSON symbol).
+		await dispatch(
+			controller,
+			ctx,
+			makeStreamingMessage([
+				{ type: "toolCall", id: "tc-1", name: "write", arguments: { path: "/tmp/demo.py", content: body } },
+			]),
+		);
+
+		const component = pendingTools.get("tc-1");
+		if (!component) throw new Error("expected pending component for tc-1");
+		const frame = Bun.stripANSI(component.render(100).join("\n"));
+		// The write renderer shows a numbered-gutter body; the generic
+		// fallback dumps args on one escaped line and never matches this.
+		expect(frame).toMatch(/2 print\("line 2"\)/);
+		expect(frame).toContain("demo.py");
+	});
+});
