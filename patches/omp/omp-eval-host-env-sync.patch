+# afk: host environment as of the previous request's `hostEnv` (see
+# _sync_host_env). Starts empty, so the first request mirrors all of it.
+_HOST_ENV: dict = {}
+
+
+def _sync_host_env(host_env: dict) -> None:
+    """Mirror host environment changes into ``os.environ``.
+
+    Only keys whose host value changed since the previous request are written,
+    and keys the host dropped are removed, so a variable a cell set itself
+    survives until the host changes that same key. Managed keys stay owned by
+    the per-request ``env`` patch.
+    """
+    global _HOST_ENV
+    current = {
+        key: value
+        for key, value in host_env.items()
+        if isinstance(key, str) and isinstance(value, str) and key not in _MANAGED_ENV_KEYS
+    }
+    for key in _HOST_ENV.keys() - current.keys():
+        os.environ.pop(key, None)
+    for key, value in current.items():
+        if _HOST_ENV.get(key) != value:
+            os.environ[key] = value
+    _HOST_ENV = current
+
+
 
