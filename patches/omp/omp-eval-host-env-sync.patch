+/**
+ * afk: the environment a live Python kernel mirrors from its host — the
+ * child-shell env the bash tool would get (`shellEnv`, built from live
+ * `process.env`), minus the API-key denylist, with the kernel's venv layout
+ * re-applied so PATH keeps the venv bin first. Unlike {@link filterEnv} there is
+ * no allowlist: with eval as the only command runner, devshell variables
+ * (CC, PKG_CONFIG_PATH, NIX_*, …) must reach `subprocess` calls.
+ */
+export function hostKernelEnv(runtime: PythonRuntime, shellEnv: Record<string, string>): Record<string, string> {
+	const base: Record<string, string> = {};
+	for (const [key, value] of Object.entries(shellEnv)) {
+		if (!NORMALIZED_DENYLIST.has(normalizeEnvKey(key))) base[key] = value;
+	}
+	if (!runtime.venvPath) return base;
+	return applyVenvEnv(base, runtime.venvPath, venvBinDir(runtime.venvPath)) as Record<string, string>;
+}
