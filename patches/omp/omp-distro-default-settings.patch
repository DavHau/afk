+	/**
+	 * Lenient loader for distribution defaults ($OMP_DISTRO_CONFIG): merged
+	 * below the global config so user settings always win. A missing or
+	 * malformed file degrades to {} with a logged warning, never an error —
+	 * a broken distribution file must not brick the binary. The tagged
+	 * YamlLoadResult is unwrapped here rather than through
+	 * #unwrapYamlLoadResult, which throws on invalid/unreadable, and never
+	 * through the write-locked path: the distribution file is read-only.
+	 */
+	async #loadDistroDefaults(): Promise<RawSettings> {
+		const raw = process.env.OMP_DISTRO_CONFIG?.trim();
+		if (!raw) return {};
+		const filePath = path.resolve(expandTilde(raw));
+		const result = await this.#loadYamlIfPresent(filePath);
+		if (result.kind === "loaded") return result.settings;
+		if (result.kind !== "missing") {
+			logger.warn("Settings: ignoring distribution defaults", {
+				path: filePath,
+				error: String(result.error),
+			});
+		}
+		return {};
+	}
+
