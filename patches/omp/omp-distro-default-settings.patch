diff --git a/packages/coding-agent/test/config/distro-mirror.test.ts b/packages/coding-agent/test/config/distro-mirror.test.ts
new file mode 100644
index 0000000000..933c2b9ea6
--- /dev/null
+++ b/packages/coding-agent/test/config/distro-mirror.test.ts
@@ -0,0 +1,37 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { Settings, type SettingsMirrorSource } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { cfgTaskIsolationApply } from "@oh-my-pi/pi-coding-agent/task/settings";
+
+// afk: the distribution-defaults layer ($OMP_DISTRO_CONFIG) must reach worker-thread
+// settings mirrors too. A mirror never runs init(), so it only sees the distro layer
+// when the main instance's mirror state carries it.
+describe("distro defaults on worker settings mirrors", () => {
+	let tmp: string;
+	let previous: string | undefined;
+
+	beforeEach(() => {
+		tmp = fs.mkdtempSync(path.join(os.tmpdir(), "omp-distro-mirror-"));
+		previous = process.env.OMP_DISTRO_CONFIG;
+		const distroPath = path.join(tmp, "distro.yml");
+		fs.writeFileSync(distroPath, "task:\n  isolation:\n    apply: false\n");
+		process.env.OMP_DISTRO_CONFIG = distroPath;
+	});
+
+	afterEach(() => {
+		if (previous === undefined) delete process.env.OMP_DISTRO_CONFIG;
+		else process.env.OMP_DISTRO_CONFIG = previous;
+		fs.rmSync(tmp, { recursive: true, force: true });
+	});
+
+	it("carries the distro layer through mirrorState", async () => {
+		const main = await Settings.loadIsolated({ inMemory: true, cwd: tmp, agentDir: tmp });
+		expect(cfgTaskIsolationApply.get(main)).toBe(false);
+
+		const source = {} as SettingsMirrorSource;
+		const mirror = Settings.mirror(source, main.mirrorState());
+		expect(cfgTaskIsolationApply.get(mirror)).toBe(false);
+	});
+});
