+ * matching property's sub-schema. Array-typed properties (e.g. `findings`, derived from JTD
+ * `elements`) accept either shape the tool's parameter schema advertises: a single element
+ * (validated against the items schema) or the whole section array (validated against the
+ * property schema) — array payloads are always read as section content, never as one element.
+ * Scalar properties use the property schema directly. Closed top-level schemas reject labels
+ * that are not declared as properties.
  */
 function buildSectionValidators(
 	jsonSchema: Record<string, unknown>,
@@ -124,11 +126,16 @@ function buildSectionValidators(
 	for (const label in properties) {
 		const raw = properties[label];
 		const propRecord = isRecord(raw) ? raw : undefined;
-		const sectionSchema =
+		const itemsSchema =
 			propRecord?.type === "array" && propRecord.items !== undefined && propRecord.items !== null
 				? propRecord.items
-				: raw;
-		validators.set(label, value => validateJsonSchemaValue(sectionSchema, value));
+				: undefined;
+		const sectionSchema = itemsSchema ?? raw;
+		validators.set(label, value =>
+			itemsSchema !== undefined && Array.isArray(value)
+				? validateJsonSchemaValue(raw, value)
+				: validateJsonSchemaValue(sectionSchema, value),
+		);
 	}
 	return validators;
 }
