+	it("accepts a whole-array payload for array-typed labels and assembles it as elements", async () => {
+		// The tool's parameter schema advertises the full array branch for `findings`
+		// (withSectionVariants), so models legitimately submit several findings in one
+		// call. The array is validated against the property schema and splatted into
+		// the section instead of nesting as a single element.
+		const outputSchema = {
+			optionalProperties: {
+				findings: {
+					elements: {
+						properties: {
+							title: { type: "string" },
+							body: { type: "string" },
+						},
+					},
+				},
+			},
+		};
+		const tool = new YieldTool(createSession({ outputSchema }));
+
+		const first = { title: "bug", body: "details" };
+		const second = { title: "nit", body: "style" };
+		const accepted = await tool.execute("call-findings-array", {
+			type: ["findings"],
+			data: [first, second],
+		} as never);
+		expect(accepted.details?.data).toEqual([first, second]);
+		expect(accepted.details?.schemaOverridden).toBeUndefined();
+
+		// An array with an invalid element still gets per-call retry feedback.
+		await expect(
+			tool.execute("call-findings-array-bad", {
+				type: ["findings"],
+				data: [first, { title: "only-title" }],
+			} as never),
+		).rejects.toThrow(/Section "findings" does not match schema.*body/);
+
+		// Assembly splats the array payload and appends later single elements.
+		const third = { title: "later", body: "more" };
+		const assembled = assembleYieldResult(
+			[
+				{ status: "success", type: ["findings"], data: [first, second] },
+				{ status: "success", type: ["findings"], data: third },
+			] as never,
+			undefined,
+			yieldSectionShapes(outputSchema),
+		);
+		expect(assembled?.data).toEqual({ findings: [first, second, third] });
+	});
+
