+ * packed, and reftable ref stores uniformly.
+ */
+async function gitUpdateRef(repoRoot: string, refName: string, commitSha: string): Promise<void> {
+	const proc = Bun.spawn(["git", "update-ref", refName, commitSha], {
+		cwd: repoRoot,
+		stdout: "ignore",
+		stderr: "pipe",
+		windowsHide: true,
+	});
+	const [stderr, exitCode] = await Promise.all([new Response(proc.stderr).text(), proc.exited]);
+	if (exitCode !== 0) {
+		throw new Error(`git update-ref ${refName} failed: ${stderr.trim() || `exit code ${exitCode}`}`);
+	}
+}
+
